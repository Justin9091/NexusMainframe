PROJECT_NAME           = "NexusMainFrame"
PROJECT_BRIEF          = "Modular framework for embedded/desktop systems"
PROJECT_NUMBER         = 1.0

OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

# Input
INPUT                  = includes README.md
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

# Exclude generated/vendor paths
EXCLUDE_PATTERNS       = */cmake-build-*/* */_deps/* */tests/*

# Extract everything, including undocumented members
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_LATEX         = NO

# Nicer HTML theme
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = DARK

# Diagrams (requires Graphviz — disabled for CI compatibility)
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES

# Warnings
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
QUIET                  = NO
